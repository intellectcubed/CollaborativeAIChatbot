# Copy to .env (git-ignored) and fill in. Only the agent container reads it.
ANTHROPIC_API_KEY=
# Optional
# LLM_MODEL=claude-haiku-5-5
# LLM_EFFORT=low
# INTENT_MODEL=claude-haiku-5-5   # model for the intent check; 'off' disables it
# INTENT_SKIP_CONFIDENCE=0.8      # skip Tier 1 only when the intent check says no at least this confidently

# Calendar service (not used by the agent yet). Point at the MIRROR for development, never production.
# CALENDAR_BASE_URL=
# CALENDAR_HEADERS={}             # optional JSON of request headers, e.g. for auth
# CALENDAR_ALLOW_WRITES=1         # also needs mode = "live" in config/policy.toml; leave unset for dry runs
